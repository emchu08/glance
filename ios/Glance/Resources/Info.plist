<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>Glance</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>glance</string></array></dict></array>
  <key>GLANCE_API_BASE</key><string>$(GLANCE_API_BASE)</string>
  <key>META_APP_ID</key><string>$(META_APP_ID)</string>
  <key>META_CLIENT_TOKEN</key><string>$(META_CLIENT_TOKEN)</string>
  <key>NSCameraUsageDescription</key><string>Glance uses the camera on your glasses or phone to recognize products you choose to scan.</string>
  <key>NSBluetoothAlwaysUsageDescription</key><string>Glance connects to your Meta glasses over Bluetooth.</string>
  <key>NSLocalNetworkUsageDescription</key><string>Glance talks to your glasses and the local development server.</string>
  <key>NSBonjourServices</key><array><string>_glance._tcp</string></array>
  <key>UISupportedExternalAccessoryProtocols</key><array><string>com.meta.wearables</string></array>
  <key>UIRequiredDeviceCapabilities</key><array><string>armv7</string><string>bluetooth-le</string><string>video-camera</string></array>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
  <key>UILaunchScreen</key><dict/>
  <key>ITSAppUsesNonExemptEncryption</key><false/>
</dict></plist>
