# Copy to .env.local and fill in. All values below are placeholders.
APP_URL=http://localhost:3000

# Supabase — publishable key is safe in clients; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Optional: direct Postgres connection for `npm run db:migrate`
SUPABASE_DB_URL=

# Stripe sandbox. Live payments stay disabled server-side.
STRIPE_API_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=
PAYMENTS_MODE=sandbox
ENABLE_LIVE_PAYMENTS=false
# Sandbox example commission: 10% of item subtotal (basis points)
GLANCE_COMMISSION_BPS=1000

# Anthropic — server only. Leave empty to run in deterministic sample mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Secrets for signed ad attribution tokens and device pairing
AD_ATTRIBUTION_SECRET=change-me
RELAY_SECRET=change-me

# Demo wallet account used in docs/DEMO.md (sandbox only)
DEMO_ACCOUNT_EMAIL=demo-judge@glance.test
DEMO_ACCOUNT_PASSWORD=choose-a-password
